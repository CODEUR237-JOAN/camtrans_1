# ==============================================================
# FICHIER : .env.example
# CamTrans — Template de configuration des variables d'environnement
#
# ⚠️  CE FICHIER EST UN MODÈLE — NE PAS METTRE DE VRAIES CLÉS ICI
# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Le fichier ".env" est dans .gitignore et ne doit JAMAIS être commité.
# ==============================================================

# Clés d'API Google Maps
GOOGLE_MAPS_API_KEY_ANDROID=votre_cle_api_android_ici
GOOGLE_MAPS_API_KEY_IOS=votre_cle_api_ios_ici

# Clé API Google Gemini (IA)
# Obtenir sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=votre_cle_gemini_ici

# Clé API Groq (LPU - alternative IA)
# Obtenir sur : https://console.groq.com/keys
GROQ_API_KEY=votre_cle_groq_ici

# Identifiants Campay (Paiement Mobile Money)
# Obtenir sur : https://campay.net/
# ⚠️ Utiliser les credentials de SANDBOX pour le développement
CAMPAY_USERNAME=votre_username_campay_ici
CAMPAY_PASSWORD=votre_password_campay_ici

# Mode production Campay
# false = environnement de test (https://demo.campay.net/api/)
# true  = production réelle (https://www.campay.net/api/)
CAMPAY_PRODUCTION=false

# ⚠️ NE JAMAIS METTRE LES IDENTIFIANTS ADMIN ICI
# Les credentials admin doivent être gérés via Firebase Console
# et la collection Firestore /admin/{uid}
