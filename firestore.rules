rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FONCTIONS UTILITAIRES
    // ============================================================

    function estConnecte() {
      return request.auth != null;
    }

    function estProprietaire(userId) {
      return request.auth.uid == userId;
    }

    // ✅ FIX : Détection admin uniquement via la collection Firestore.
    // L'email n'est plus codé en dur — tout changement d'admin ne nécessite
    // plus un redéploiement des règles. Ajouter l'UID de l'admin dans /admin/{uid}.
    function estAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function estClient() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/clients/$(request.auth.uid));
    }

    function estTransporteur() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/transporteurs/$(request.auth.uid));
    }

    // ============================================================
    // COLLECTION : admin
    // Tout utilisateur connecté peut lire son propre doc (pour vérifier son rôle au login).
    // Seul l'admin peut lire les docs des autres et écrire.
    // ============================================================
    match /admin/{adminId} {
      allow read: if estConnecte() && (estProprietaire(adminId) || estAdmin());
      allow write: if estAdmin();
    }

    // ============================================================
    // COLLECTION : clients
    // Accès lors de l'inscription : l'utilisateur connecté crée son propre doc.
    // Accès en lecture par les transporteurs (pour les infos client d'une course).
    // ============================================================
    match /clients/{clientId} {
      allow read: if estConnecte() && (estProprietaire(clientId) || estAdmin() || estTransporteur());
      allow create: if estConnecte() && estProprietaire(clientId);
      allow update: if estConnecte() && (estProprietaire(clientId) || estAdmin());
      allow delete: if estAdmin();
    }

    // ============================================================
    // COLLECTION : transporteurs
    // ============================================================
    match /transporteurs/{userId} {
      // Lecture : tout le monde (connecté) peut lire les transporteurs (nécessaire pour l'attribution et l'admin)
      allow read: if estConnecte();

      // Création (inscription) : le transporteur crée son propre profil, mais ne
      // peut pas s'auto-valider ni se créditer dès le départ.
      allow create: if estConnecte() && estProprietaire(userId)
        && request.resource.data.documentsValides == false
        && request.resource.data.soldePortefeuille == 0;

      // Modification : seul le transporteur peut modifier son profil, ou l'admin.
      // ✅ FIX SÉCURITÉ : le propriétaire ne peut PAS toucher aux champs sensibles
      // (solde, validation des documents, revenus, note) — réservés à l'admin /
      // au serveur. Empêche l'auto-crédit du portefeuille et l'auto-validation.
      allow update: if estConnecte() && (
        estAdmin() ||
        (estProprietaire(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['soldePortefeuille', 'documentsValides', 'revenusTotaux', 'noteMoyenne']))
      );

      allow delete: if estConnecte() && (estProprietaire(userId) || estAdmin());
    }

    // ============================================================
    // COLLECTION : utilisateurs (profil générique, token FCM)
    // ============================================================
    match /utilisateurs/{userId} {
      allow read: if estConnecte() && (estProprietaire(userId) || estAdmin());
      allow write: if estConnecte() && (estProprietaire(userId) || estAdmin());
    }

    // ============================================================
    // COLLECTION : courses
    // ============================================================
    match /courses/{courseId} {
      // Lecture : admin, client propriétaire, ou transporteur (assigné ou en recherche)
      allow read: if estConnecte() && (
        estAdmin() ||
        resource.data.clientId == request.auth.uid ||
        resource.data.transporteurId == request.auth.uid ||
        resource.data.statut == 'recherche'
      );

      // Création : client uniquement (ou admin)
      allow create: if estConnecte() && (estClient() || estAdmin());

      // Modification : admin, ou client (seulement si recherche/annulé), ou transporteur assigné (seulement statut)
      allow update: if estConnecte() && (
        estAdmin() ||
        // Le client est le propriétaire (permissions très larges pour débloquer l'annulation)
        (resource.data.clientId == request.auth.uid) ||
        // Le transporteur ne peut modifier que s'il est ciblé, et que pour accepter/refuser/progresser
        (resource.data.transporteurId == request.auth.uid) ||
        // Gérer le cas de l'attribution temporaire (où transporteurId est vide mais l'update ajoute un ID)
        (resource.data.statut in ['recherche', 'propose'] && request.resource.data.statut in ['propose', 'attribue'])
      );

      allow delete: if estConnecte() && (
        estAdmin() ||
        (resource.data.clientId == request.auth.uid && resource.data.statut == 'recherche')
      );

      // Sous-collection des messages du chat in-app
      // ✅ FIX SÉCURITÉ : était ouverte à TOUS les connectés (n'importe qui
      // pouvait lire/écrire le chat de n'importe quelle course).
      // Désormais : seuls le client, le transporteur de la course, ou l'admin.
      match /messages/{messageId} {
        allow read, write: if estConnecte() && (
          estAdmin() ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.transporteurId == request.auth.uid
        );
      }
    }

    // ============================================================
    // COLLECTION : paiements
    // ============================================================
    match /paiements/{paiementId} {
      allow read: if estConnecte() && (
        estAdmin() ||
        resource.data.clientId == request.auth.uid ||
        resource.data.transporteurId == request.auth.uid
      );
      allow create: if estConnecte() && (estClient() || estAdmin() || estTransporteur());
      allow update: if estAdmin();
      allow delete: if estAdmin();
    }

    // ============================================================
    // COLLECTION : notifications (in-app)
    // ============================================================
    match /notifications/{notifId} {
      allow read: if estConnecte() && (
        estAdmin() ||
        resource.data.utilisateurId == request.auth.uid
      );
      allow create: if estConnecte() && (
        estAdmin() || 
        request.resource.data.utilisateurId == request.auth.uid ||
        request.resource.data.utilisateurId == 'ADMIN'
      );
      allow update: if estConnecte() && (
        estAdmin() || resource.data.utilisateurId == request.auth.uid
      );
      allow delete: if estConnecte() && (
        estAdmin() || resource.data.utilisateurId == request.auth.uid
      );
    }

    // ============================================================
    // COLLECTION : notifications_push (file d'attente traitée par la
    // Cloud Function `envoyerNotificationGlobale`).
    //  - Diffusion (tous / clients / transporteurs) : admin uniquement.
    //  - Envoi ciblé vers UNE personne (ex. cascade chauffeur) : tout
    //    utilisateur connecté, uniquement en statut "pending".
    // ============================================================
    match /notifications_push/{notifId} {
      allow read: if estAdmin();
      allow create: if estAdmin() || (
        estConnecte()
        && request.resource.data.cible in ['client', 'transporteur']
        && request.resource.data.cibleId is string
        && request.resource.data.cibleId.size() > 0
        && request.resource.data.status == 'pending'
      );
      allow update, delete: if estAdmin();
    }

    // ============================================================
    // COLLECTION : messages (messagerie client <-> transporteur)
    // ✅ FIX : La lecture était ouverte à tous les connectés.
    // Maintenant seuls l'expéditeur, le destinataire et l'admin peuvent lire.
    // ============================================================
    match /messages/{messageId} {
      allow read: if estConnecte() && (
        estAdmin() ||
        resource.data.expediteurId == request.auth.uid ||
        resource.data.destinataireId == request.auth.uid
      );
      allow create: if estConnecte() && request.resource.data.expediteurId == request.auth.uid;
      allow update, delete: if estAdmin();
    }

    // ============================================================
    // COLLECTION : parametres (CMS, configuration globale)
    // ============================================================
    match /parametres/{document=**} {
      allow read: if estConnecte(); // Tous les utilisateurs connectés peuvent lire les paramètres
      allow write: if estAdmin();   // Seul l'admin peut modifier
    }

    // ============================================================
    // COLLECTION : evaluations (notes & avis des clients sur les courses)
    // Lecture : tout connecté (pour calculer la note moyenne d'un
    // transporteur). Création : par le client auteur uniquement.
    // ============================================================
    match /evaluations/{evalId} {
      allow read: if estConnecte();
      allow create: if estConnecte() &&
        request.resource.data.clientId == request.auth.uid;
      allow update, delete: if estAdmin();
    }

    // ============================================================
    // COLLECTION : index_telephones (unicité des numéros à l'inscription)
    // Clé = numéro normalisé. Lecture : tout connecté (test d'existence).
    // Création : réservée à son propre compte. Modif/suppr : propriétaire/admin.
    // ============================================================
    match /index_telephones/{telephone} {
      allow read: if estConnecte();
      allow create: if estConnecte() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if estConnecte() &&
        (estAdmin() || resource.data.uid == request.auth.uid);
    }

    // ============================================================
    // COLLECTION : historique_retraits (retraits du portefeuille ADMIN)
    // Revenus propres de la plateforme. Lecture/écriture : ADMIN uniquement.
    // ============================================================
    match /historique_retraits/{retraitId} {
      allow read, write: if estAdmin();
    }

    // ============================================================
    // COLLECTION : abonnements (Abonnements des transporteurs)
    // ============================================================
    match /abonnements/{abonnementId} {
      allow read: if estConnecte() && (
        estAdmin() || 
        resource.data.transporteurId == request.auth.uid
      );
      allow create: if estConnecte() && estTransporteur();
      allow update, delete: if estAdmin();
    }

  }
}

